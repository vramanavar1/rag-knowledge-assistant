# Copy to .env and fill in.  Never commit .env.
#
# NOTE: this file is a TEMPLATE and is never read by the app. Only a file
# literally named `.env` is loaded (by python-dotenv). Every default below
# is also the default in src/rag/config.py, so deleting a line here changes
# nothing -- the code default applies.
# Every value below is optional: with none of them set the app runs fully
# offline on the local backend + local embedder, and says so at startup.

# ---------------------------------------------------------------- Azure OpenAI
# MASTER SWITCH. Credentials alone are NOT enough: without this set to true the
# app uses the local embedder and extractive answers, even if a valid endpoint
# and key are present in your environment.
#
# It exists because credentials are usually inherited, not chosen -- a
# machine-wide AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_DEPLOYMENT_NAME would
# otherwise make a run you think is "local" send document passages to a cloud
# model and bill you for it. The search backend already fails closed; this makes
# Azure OpenAI behave the same way.
AZURE_OPENAI_ENABLED=false

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21

# Chat model used for answering, reranking, condensing and the eval judge.
# AZURE_OPENAI_DEPLOYMENT_NAME is also accepted, for compatibility with an
# environment that already exports it.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Cheaper model for the high-volume auxiliary calls (rerank / condense /
# verify / judge). These are ~75% of the model calls and ~78% of the latency,
# so pointing them at a mini deployment is the single largest cost and speed
# win available. Falls back to AZURE_OPENAI_CHAT_DEPLOYMENT when unset or when
# the named deployment does not exist.
AZURE_OPENAI_UTILITY_DEPLOYMENT=gpt-4o-mini

# Embeddings. Probed at startup; falls back to the local hashed-feature
# embedder if absent, which has no notion of synonymy. Deploying a real
# embedding model is the biggest retrieval-quality lever here.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- TLS, for networks that intercept HTTPS ---------------------------------
# Symptom: every Azure call fails with
#   CERTIFICATE_VERIFY_FAILED: unable to get local issuer certificate
# Preferred fix: trust your corporate root CA explicitly.
# AZURE_CA_BUNDLE=/path/to/corp-root.pem
# Or load the OS trust store (on Windows this usually already has it):
# AZURE_USE_SYSTEM_CERTS=true
# Last resort, local development only. Logs a warning on every start.
# AZURE_TLS_VERIFY=false

# ------------------------------------------------------------- Concurrency
# HTTP connection pool per provider. One question fans out to as many as three
# concurrent searches, so a replica holding N questions wants roughly 3N. Set it
# too low and the pool -- not the thread count -- becomes the bottleneck, and the
# readiness probe queues behind query traffic.
# AZURE_HTTP_MAX_CONNECTIONS=200
#
# How many embedding batches may be in flight at once during ingestion. This is
# the back-pressure valve against Azure OpenAI TPM quota: raising it does not
# make a large ingest faster once you are quota-bound, it just produces 429s.
# AZURE_EMBED_CONCURRENCY=8

# ------------------------------------------------------------- Azure AI Search
# RETRIEVER_BACKEND=local (default) | azure
RETRIEVER_BACKEND=local
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<admin-key>
AZURE_SEARCH_INDEX=northwind-kb
AZURE_SEARCH_API_VERSION=2024-07-01
# Semantic (L2) reranking requires the Basic SKU or above. On the Free tier set
# this to false; the app also detects the failure at runtime and degrades once,
# loudly, rather than erroring.
AZURE_SEARCH_SEMANTIC=true

# ------------------------------------------------------------------- Behaviour
# RAG_PROFILE=improved (default) | baseline   <- baseline is the naive "before" system
RAG_PROFILE=improved
RAG_DATA_DIR=data
RAG_SOURCE_DIR=KnwoledgeBaseDocuments

# Retrieval tuning
RAG_RETRIEVE_TOP_K=20          # candidates fetched before reranking
RAG_CONTEXT_TOP_K=5            # chunks actually put in the prompt
RAG_MIN_RELEVANCE=4.0          # 0-10 rerank score below which we abstain

# ---------------------------------------------------------------- Observability
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Adds an "env" block to /health listing every variable the app reads, including
# the ones that are UNSET -- which is the point: an absent variable, or a Key
# Vault secretref that resolved to nothing, is invisible in a normal env dump.
# Secret values are never printed regardless of this flag; they render as
# "<set len=32 sha256:9f2a1c7d>". Turn it off again once you are done: /health
# is unauthenticated, and the variable *names* alone are worth not publishing.
SHOW_ENV_VALUES=false

# What happens when the startup contract is violated -- with RETRIEVER_BACKEND=azure,
# the embedder's vector width must match the index's. Neither mode answers questions
# it cannot ground; they differ in what is left to diagnose with.
#   unready (default) - stay up, fail readiness, serve the reason at /health
#   crash             - exit at boot; no replica, so no /health and no log stream
STARTUP_FAIL_MODE=unready

# ------------------------------------------------------------------------- API
API_ALLOWED_ORIGINS=http://localhost:8000
